<?xml version="1.0" encoding="utf-8"?>
<!-- PlayStation blue at rest, white when the TV remote focuses it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#ffffff" />
    <item android:state_pressed="true" android:color="@color/ps_blue_lit" />
    <item android:color="@color/ps_blue" />
</selector>
